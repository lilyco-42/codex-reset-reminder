{
  "name": "codex-reset-reminder",
  "private": true,
  "version": "0.1.0",
  "description": "Codex 额度重置提醒器：Windows / Linux / macOS / Android / iOS",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "icon": "tauri icon src-tauri/app-icon.png -o src-tauri/icons",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "ios:init": "tauri ios init",
    "probe": "node scripts/probe-sources.mjs",
    "test": "cd src-tauri && cargo test --locked",
    "fmt": "cd src-tauri && cargo fmt --all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
